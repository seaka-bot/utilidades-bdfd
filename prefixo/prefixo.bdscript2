$nomention
$onlyIf[$guildID!=; ]
$c[PREFIXO. O gatilho no BDFD é só a letra s. Estas linhas conferem se depois do s vem o prefixo do servidor, guardado na variável Prefixo. Com Prefixo igual a asterisco, o comando vira s*]
$var[Prefixo;$cropText[$message;$charCount[$getServerVar[Prefixo]];]]
$onlyIf[$var[Prefixo]==$getServerVar[Prefixo]; ]
$c[NOME. cmd é a palavra logo depois do prefixo, por exemplo say em s*say]
$var[cmd;$replaceText[$toLowercase[$message[1]];$var[Prefixo];;1]]
$c[A lista logo abaixo tem os nomes que chamam este comando. Se cmd não estiver nela, triggerCMD fica vazio e o comando para em silêncio. É assim que vários comandos dividem o mesmo gatilho s]
$textSplit[prefixo prefix sea; ] $var[i;1] $var[code;$repeatMessage[$getTextSplitLength;$|if[$|or[$|var[cmd\]==$|splitText[$|var[i\]\]\;$|var[cmd\]== $|splitText[$|var[i\]\]\]==true\] $|var[triggerCMD\;true\] $|stop $|endif $|var[i%|{-SEMICOL-}%$|calculate[$|var[i\]+1\]\]]] $eval[$replaceText[$var[code];|;;-1]] $if[$var[triggerCMD]==] $stop $endif
$c[ARGUMENTOS. Tira o prefixo e o nome da mensagem e guarda cada palavra que sobrou em message1, message2, até message10]
$var[message;$replaceText[$message;$var[Prefixo]$var[cmd];;1]]
$textSplit[$var[message]; ]$var[i;1] $var[code;$repeatMessage[10;$|var[message$|var[i\]\;$|splitText[$|var[i\]\]\] ]] $eval[$replaceText[$var[code];|;;-1]]

$c[QUEM PODE. Dono do servidor e dono do bot passam direto. O resto precisa da permissão de gerenciar o servidor]
$if[$authorID==$serverOwner]

$elseif[$authorID==$botOwnerID]

$else
$onlyIf[$checkUserPerms[$authorID;manageServer]==true;( 🚫 ) - Você precisa ter permissões de gerenciar o servidor.]
$endif
$c[VALIDAÇÕES. Sem sinal de igual, porque os comandos de igual igual usam ele, não vazio e no máximo 2 caracteres]
$onlyIf[$checkContains[$var[message1];=]==false; ( 🚫 ) - Esse símbolo não pode ser utilizado.]
$onlyIf[$var[message1]!=;( 🚫 ) - Insira algo para ser meu novo prefixo.]
$onlyIf[$charCount[$var[message1]]<=2;( 🚫 ) - Meu novo prefixo não pode passar de 2 algarismos.]
$onlyIf[s$var[message1]!=s=;( 🚫 ) - Meu prefixo não pode conter esse símbolo]
$c[SALVA. O novo prefixo fica na variável de servidor Prefixo, sempre em minúsculo]
$setServerVar[Prefixo;$toLowercase[$var[message1]]]
$sendMessage[( ✅ ) - Meu prefixo foi atualizado para ``s$toLowercase[$var[message1]]``!]
