$nomention
$onlyIf[$guildID!=; ]
$c[PREFIXO. O gatilho no BDFD é só a letra s. Estas linhas conferem se depois do s vem o prefixo do servidor, guardado na variável Prefixo. Com Prefixo igual a asterisco, o comando vira s*]
$var[Prefixo;$cropText[$message;$charCount[$getServerVar[Prefixo]];]]
$onlyIf[$var[Prefixo]==$getServerVar[Prefixo]; ]
$c[NOME. cmd é a palavra logo depois do prefixo, por exemplo say em s*say]
$var[cmd;$replaceText[$message[1];$var[Prefixo];;1]]
$c[A lista logo abaixo tem os nomes que chamam este comando. Se cmd não estiver nela, triggerCMD fica vazio e o comando para em silêncio. É assim que vários comandos dividem o mesmo gatilho s]
$textSplit[unix; ] $var[i;1] $var[code;$repeatMessage[$getTextSplitLength;$|if[$|var[cmd\]==$|splitText[$|var[i\]\]\] $|var[triggerCMD\;true\] $|stop $|endif $|var[i%|{-SEMICOL-}%$|calculate[$|var[i\]+1\]\]]] $eval[$replaceText[$var[code];|;;-1]] $if[$var[triggerCMD]==] $stop $endif
$c[ARGUMENTOS. Tira o prefixo e o nome da mensagem e separa as palavras que sobraram. A primeira fica em message1, e todas continuam no split, prontas pro splitText]
$var[message;$replaceText[$message;$var[Prefixo]$var[cmd];;1]]
$textSplit[$var[message]; ]$var[i;1] $var[code;$repeatMessage[10;$|var[message$|var[i\]\;$|splitText[$|var[i\]\]\] ]] $eval[$replaceText[$var[code];|;;-1]]
$c[TEXTO. Tudo que veio depois do nome do comando, sem espaço sobrando nas pontas]
$var[texto;$trimSpace[$var[message]]]
$c[unix dia mês ano mostra o timestamp unix dessa data, à meia-noite no horário de Brasília. As três palavras vêm do split que o molde deixou pronto]
$onlyIf[$argCount[$var[texto]]==3;Use assim: `s$getServerVar[Prefixo]unix 25 12 2026` (dia mês ano)]
$onlyIf[$and[$isNumber[$splitText[1]]==true;$isNumber[$splitText[2]]==true;$isNumber[$splitText[3]]==true]==true;Só números: `s$getServerVar[Prefixo]unix 25 12 2026`]
$var[d;$splitText[1]]
$var[m;$splitText[2]]
$var[a;$splitText[3]]
$onlyIf[$and[$var[m]>=1;$var[m]<=12]==true;O mês vai de 1 a 12.]
$onlyIf[$and[$var[d]>=1;$var[d]<=31]==true;O dia vai de 1 a 31.]
$onlyIf[$var[a]>=1970;O ano precisa ser 1970 ou depois.]

$c[1. ANOS INTEIROS. 365 dias por ano desde 1970, mais 1 por ano bissexto que já passou. Bissexto é de 4 em 4 anos, menos os de 100 em 100, mas os de 400 em 400 voltam a ser]
$var[bissextos;$calculate[$floor[$calculate[($var[a]-1969)/4]]-$floor[$calculate[($var[a]-1901)/100]]+$floor[$calculate[($var[a]-1601)/400]]]]
$var[dias;$calculate[($var[a]-1970)*365+$var[bissextos]]]

$c[2. MESES. A lista tem quantos dias o ano já andou no começo de cada mês. Janeiro 0, fevereiro 31, março 59 e assim por diante]
$textSplit[0 31 59 90 120 151 181 212 243 273 304 334; ]
$var[dias;$calculate[$var[dias]+$splitText[$var[m]]+$var[d]-1]]

$c[3. FEVEREIRO. Se o ano é bissexto e a data é depois de fevereiro, fevereiro teve 29 dias]
$if[$var[m]>2]
$if[$or[$and[$modulo[$var[a];4]==0;$modulo[$var[a];100]!=0]==true;$modulo[$var[a];400]==0]==true]
$var[dias;$calculate[$var[dias]+1]]
$endif
$endif

$c[4. SEGUNDOS. Dias vezes 86400, mais 3 horas porque meia-noite em Brasília é 3 da manhã no horário universal]
$var[unix;$calculate[$var[dias]*86400+10800]]
`$var[unix]`
<t:$var[unix]:F> · <t:$var[unix]:R>
